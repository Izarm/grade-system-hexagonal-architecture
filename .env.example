# Plantilla de variables de entorno.
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=sistema_notas

# Cadena larga y aleatoria (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=correo@ejemplo.com
# Contraseña de aplicación, no la del correo
EMAIL_PASS=

# Orígenes permitidos para CORS, separados por coma.
# Si no se define, por defecto: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
